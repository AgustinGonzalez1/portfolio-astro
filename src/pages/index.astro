---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import About from "../components/AboutMe.astro";
import Experience from "../components/Experience.astro";
import Aportes from "../components/Aportes.astro";
import { profile } from "../data/profile";
---

<Layout
  title={`${profile.name} | Desarrollador Full Stack`}
  description={`Portfolio de ${profile.name}, desarrollador Full Stack y docente de programación. Proyectos web, aportes profesionales y experiencia con PERN, Python y Vue.`}
>
  <Hero />
  <div class="mx-auto container px-4">
    <div class="w-full h-[1px] bg-[#484848] mb-16 md:my-20"></div>
    <Aportes />
    <div class="w-full h-[1px] bg-[#484848] my-16 md:my-20"></div>
    <Projects />
    <div class="w-full h-[1px] bg-[#484848] my-16 md:my-20"></div>
    <div transition:name="about">
      <About />
    </div>
    <div class="w-full h-[1px] bg-[#484848] my-16 md:my-20"></div>
    <Experience />
    <div class="w-full h-[1px] bg-[#484848] my-16 md:my-20"></div>
  </div>
</Layout>
