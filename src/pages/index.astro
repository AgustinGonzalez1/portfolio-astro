---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import AboutSummary from "../components/AboutSummary.astro";
import Experience from "../components/Experience.astro";
import Aportes from "../components/Aportes.astro";
import { profile } from "../data/profile";
---

<Layout
  title={`${profile.name} | Desarrollador Full Stack`}
  description={`Portfolio de ${profile.name}, desarrollador Full Stack y docente de programación. Proyectos web, aportes profesionales y experiencia con PERN, Python y Vue.`}
>
  <Hero />
  <Projects />
  <Aportes />
  <Experience />
  <AboutSummary />
</Layout>
