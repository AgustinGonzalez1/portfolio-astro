---
interface Props {
  id: string;
  kicker: string;
  title: string;
  description: string;
}

const { id, kicker, title, description }: Props = Astro.props;
const headingId = `${id}-heading`;
---

<section class="content-section" id={id} aria-labelledby={headingId}>
  <header class="section-heading">
    <div>
      <p class="section-kicker">{kicker}</p>
      <h2 class="section-title" id={headingId}>{title}</h2>
    </div>
    <p class="section-intro">{description}</p>
  </header>
  <div class="work-list">
    <slot />
  </div>
</section>

<style>
  .content-section {
    width: min(var(--container-site), calc(100% - 80px));
    margin-inline: auto;
    padding: 116px 0 128px;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 24px;
    color: var(--color-foreground);
    font-family: var(--font-dm-sans);
    font-weight: 400;
    line-height: normal;
    -webkit-font-smoothing: antialiased;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    align-items: end;
    gap: 70px;
    margin-bottom: 62px;
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #747b82;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    content: "";
    width: 24px;
    height: 1px;
    flex: none;
    background: var(--color-accent);
  }

  .section-title {
    margin-top: 17px;
    max-width: 850px;
    font-family: var(--font-display);
    font-size: clamp(48px, 4.8vw, 78px);
    font-weight: 400;
    line-height: 1.01;
    letter-spacing: -0.035em;
  }

  .section-intro {
    margin-bottom: 4px;
    max-width: 400px;
    color: #878e95;
    font-size: 14px;
    line-height: 1.82;
  }

  .work-list {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1150px) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr) 330px;
      gap: 42px;
    }
  }

  @media (max-width: 900px) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      margin-bottom: 48px;
    }

    .section-intro {
      max-width: 580px;
    }
  }

  @media (max-width: 720px) {
    .content-section {
      width: calc(100% - 34px);
      padding: 80px 0 94px;
    }

    .section-heading {
      margin-bottom: 44px;
    }

    .section-title {
      font-size: clamp(42px, 10.5vw, 60px);
    }

    .section-intro {
      font-size: 13px;
    }
  }
</style>
