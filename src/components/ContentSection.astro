---
interface Props {
  id: string;
  kicker: string;
  title: string;
  description: string;
  class?: string;
}

const { id, kicker, title, description, class: className }: Props = Astro.props;
const headingId = `${id}-heading`;
---

<section
  class:list={["content-section", className]}
  id={id}
  aria-labelledby={headingId}
>
  <header class="section-heading">
    <div>
      <p class="section-kicker">{kicker}</p>
      <h2 class="section-title" id={headingId}>{title}</h2>
    </div>
    <p class="section-intro">{description}</p>
  </header>
  <div class="work-list">
    <slot />
  </div>
</section>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    align-items: end;
    gap: 70px;
    margin-bottom: 62px;
  }

  .section-title {
    margin-top: 17px;
    max-width: 850px;
    font-family: var(--font-display);
    font-size: clamp(48px, 4.8vw, 78px);
    font-weight: 400;
    line-height: 1.01;
    letter-spacing: -0.035em;
  }

  .section-intro {
    margin-bottom: 4px;
    max-width: 400px;
    color: #878e95;
    font-size: 14px;
    line-height: 1.82;
  }

  .work-list {
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1150px) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr) 330px;
      gap: 42px;
    }
  }

  @media (max-width: 900px) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      margin-bottom: 48px;
    }

    .section-intro {
      max-width: 580px;
    }
  }

  @media (max-width: 720px) {
    .section-heading {
      margin-bottom: 44px;
    }

    .section-title {
      font-size: clamp(42px, 10.5vw, 60px);
    }

    .section-intro {
      font-size: 13px;
    }
  }
</style>
