---
import { profile } from "../data/profile";
---

<section
  id="about"
  class="content-section about-summary"
  aria-labelledby="about-heading"
  transition:name="about"
>
  <div class="about-grid">
    <div>
      <p class="section-kicker">Sobre mí</p>
      <h2 class="about-title" id="about-heading">
        {profile.about.summary.title}
      </h2>
    </div>
    <div class="about-copy">
      {
        profile.about.summary.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))
      }
      <a class="text-link about-link" href="/about">
        <span>Más sobre mí <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>
