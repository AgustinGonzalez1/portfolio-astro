---
import { profile } from "../data/profile";
---

<section
  id="about"
  class="content-section"
  aria-labelledby="about-heading"
  transition:name="about"
>
  <div class="about-grid">
    <div>
      <p class="section-kicker">Sobre mí</p>
      <h2 class="about-title" id="about-heading">
        {profile.about.summary.title}
      </h2>
    </div>
    <div class="about-copy">
      {
        profile.about.summary.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))
      }
      <a class="about-link" href="/about">
        <span>Más sobre mí <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 70px;
    align-items: start;
  }

  .about-title {
    margin-top: 18px;
    max-width: 760px;
    font-family: var(--font-display);
    font-size: clamp(46px, 4.6vw, 72px);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .about-copy {
    padding-top: 34px;
  }

  .about-copy p {
    color: #8a9197;
    font-size: 14px;
    line-height: 1.85;
  }

  .about-copy p + p {
    margin-top: 18px;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    margin-top: 23px;
    color: #c4c8cc;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-accent);
    transition: color 0.2s ease;
  }

  .about-link:hover {
    color: var(--color-accent);
  }

  .about-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  @media (max-width: 1150px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 44px;
    }
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .about-copy {
      max-width: 620px;
      padding-top: 0;
    }
  }

  @media (max-width: 720px) {
    .about-title {
      font-size: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-link {
      transition: none;
    }
  }
</style>
