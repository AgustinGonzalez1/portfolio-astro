---
import { Image } from "astro:assets";
import { profile } from "../data/profile";

const currentYear = new Date().getFullYear();
const photoRatio = profile.photo.width / profile.photo.height;
const photoSizes = [
  `(min-width: 1051px) ${Math.ceil(Math.max(606, 640 * photoRatio))}px`,
  `(min-width: 721px) max(${Math.ceil(540 * photoRatio)}px, calc(100vw - 80px))`,
  `max(${Math.ceil(430 * photoRatio)}px, calc(100vw - 34px))`,
].join(", ");
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="copy">
      <p class="kicker">{profile.hero.roles}</p>
      <h1 id="hero-title">
        {profile.hero.title}<br />
        con <em>{profile.hero.highlight}</em>
      </h1>
      <p class="lead">{profile.hero.description}</p>
      <div class="actions">
        <a class="button-primary" href="#projects">
          <span>Ver proyectos</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="secondary" href="/about">
          Sobre mí <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="meta" aria-label="Tecnologías y ubicación">
        {profile.hero.meta.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="visual">
      <span class="sideword" aria-hidden="true"
        >Vulcanis · Portfolio {currentYear}</span
      >
      <div class="photo">
        <Image
          src={profile.photo}
          alt={profile.photoAlt}
          width={Math.min(profile.photo.width, 960)}
          widths={[320, 480, 640, 960, 1280, 1536]}
          sizes={photoSizes}
          format="webp"
          priority
        />
        <span class="index" aria-hidden="true">01</span>
        <div class="status-badge">
          <div class="status-copy">
            <p class="status-row">
              <span class="status-dot" aria-hidden="true"></span>
              <span>Disponible para</span>
            </p>
            <strong>{profile.hero.availability}</strong>
          </div>
          <span class="status-arrow" aria-hidden="true">↗</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    color: var(--color-foreground);
    font-family: var(--font-dm-sans);
    font-weight: 400;
    line-height: normal;
    scroll-margin-top: 0;
    -webkit-font-smoothing: antialiased;
  }

  .hero-inner {
    width: min(var(--container-site), calc(100% - 80px));
    min-height: calc(100svh - 84px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(500px, 0.88fr);
    align-items: center;
    gap: 72px;
    padding: 54px 0 64px;
  }

  .copy {
    max-width: 760px;
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    color: #a7acb1;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .kicker::before {
    content: "";
    width: 26px;
    height: 1px;
    flex: none;
    background: var(--color-accent);
  }

  h1 {
    max-width: 780px;
    font-family: var(--font-display);
    font-size: clamp(70px, 7vw, 116px);
    line-height: 0.94;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  h1 em {
    color: var(--color-accent);
    font-style: normal;
  }

  .lead {
    margin: 30px 0 34px;
    max-width: 580px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .secondary {
    padding: 10px 0 8px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-accent);
  }

  .meta {
    margin-top: 50px;
    display: flex;
    gap: 30px;
    color: #777e85;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .meta li + li::before {
    content: "•";
    margin-right: 30px;
    color: var(--color-accent);
  }

  .visual {
    position: relative;
    min-width: 0;
    min-height: 640px;
  }

  .photo {
    position: absolute;
    inset: 0 0 0 54px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: #0c0e10;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.72) brightness(0.84) contrast(1.04);
  }

  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 9, 10, 0.22), transparent 28%),
      linear-gradient(180deg, transparent 60%, rgba(8, 9, 10, 0.28));
    pointer-events: none;
  }

  .sideword {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(-40%, -50%) rotate(-90deg);
    color: #545a60;
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .index {
    position: absolute;
    right: 18px;
    top: 16px;
    font-family: var(--font-display);
    font-size: 22px;
    color: #5a6066;
    z-index: 2;
  }

  .status-badge {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 3;
    min-width: 220px;
    padding: 16px 18px;
    border: 1px solid var(--color-border-strong);
    background: rgba(9, 10, 12, 0.84);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .status-copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cfd3d7;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .status-copy strong {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f0ede7;
  }

  .status-arrow {
    color: var(--color-accent);
    font-size: 18px;
    line-height: 1;
  }

  @media (max-width: 1050px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 46px;
    }

    .visual {
      min-height: 540px;
    }

    .photo {
      left: 0;
    }

    .sideword {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      min-height: 0;
      padding: 74px 0 100px;
    }
  }

  @media (max-width: 720px) {
    .hero-inner {
      width: calc(100% - 34px);
      padding-bottom: 86px;
    }

    h1 {
      font-size: 58px;
    }

    .actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .visual {
      min-height: 430px;
    }

    .meta {
      gap: 14px;
      flex-wrap: wrap;
    }

    .meta li + li::before {
      margin-right: 14px;
    }

    .status-badge {
      left: 16px;
      right: 16px;
      bottom: 16px;
      min-width: 0;
    }
  }
</style>
