---
import { Image } from "astro:assets";
import { profile } from "../data/profile";
import SocialLinks from "./SocialLinks.astro";
---

<header
  class="flex flex-col gap-8 md:flex-row md:gap-20 overflow-hidden h-screen justify-center items-center"
>
  <section
    class="flex flex-col gap-8 justify-center items-center md:items-start"
  >
    <div class="flex flex-col gap-3 justify-center items-center md:items-start">
      <h1
        class="hero-reveal text-4xl font-bebas text-white xl:text-8xl text-center md:text-left"
      >
        Hola, soy {profile.name}.
      </h1>
      <p
        class="hero-reveal text-subtext font-manrope lg:text-lg w-9/12 text-center md:text-left"
        style="--reveal-delay: 100ms"
      >
        {profile.hero.roles} • {" "}
        <a
          href={profile.youtube.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:text-primary/50 duration-300"
        >
          {profile.youtube.name}
        </a>
        {" "}
        {profile.hero.description}
      </p>
    </div>
    <div class="hero-reveal flex gap-4" style="--reveal-delay: 200ms">
      <a
        href="#contact"
        class="font-manrope flex items-center font-bold bg-primary border-2 border-primary hover:bg-transparent hover:text-white duration-200 rounded-full p-1 px-4 gap-3 text-sm"
      >
        CONTACTAME
      </a>

      <SocialLinks />
    </div>
  </section>
  <section
    class="mx-auto max-w-80 sm:max-w-[400px] md:max-w-[600px] flex justify-center items-center"
  >
    <Image
      src={profile.photo}
      alt={profile.photoAlt}
      width={600}
      height={600}
      widths={[240, 300, 480, 600, 900, 1024]}
      sizes="(min-width: 768px) 600px, (min-width: 640px) 300px, 240px"
      format="webp"
      fit="cover"
      priority
      class="hero-reveal rounded-full w-60 sm:w-[300px] md:w-[600px] h-auto object-cover border-2 border-primary aspect-square"
      style="--reveal-delay: 300ms"
    />
  </section>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-reveal {
      animation: hero-fade-in 500ms ease-in-out var(--reveal-delay, 0ms) both;
    }
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
