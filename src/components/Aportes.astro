---
import { contributions } from "../data/contributions";
import WorkRow from "./WorkRow.astro";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="contributions"
  kicker="Aportes"
  title="Trabajo real dentro de productos y equipos."
  description="Contribuciones en productos, integraciones, herramientas internas y espacios de enseñanza."
>
  {
    contributions.map((contribution, index) => (
      <WorkRow {...contribution} index={index + 1} />
    ))
  }
</ContentSection>
