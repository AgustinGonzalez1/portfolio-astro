---
import { contributions } from "../data/contributions";
import type { Contribution } from "../types/contributions";
import WorkCard from "./WorkCard.astro";
import WorkSection from "./WorkSection.astro";
---

<WorkSection
  id="contributions"
  title="Mejores Aportes"
  description="Estos son algunos de los mejores aportes que he realizado a lo largo de mi carrera profesional como full stack"
>
  {
    contributions.map((contribution: Contribution) => (
      <WorkCard {...contribution} />
    ))
  }
</WorkSection>
