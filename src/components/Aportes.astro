<WorkSection
  id="contributions"
  title="Mejores Aportes"
  description="Estos son algunos de los mejores aportes que he realizado a lo largo de mi carrera profesional como full stack"
>
  {arrContributions.map((contribution) => <WorkCard {...contribution} />)}
</WorkSection>
