---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={Math.min(src.width, 960)}
  widths={[320, 480, 640, 960, 1280, 1600, 1920]}
  sizes="(min-width: 1536px) 668px, (min-width: 1280px) 540px, (min-width: 1024px) 928px, (min-width: 768px) 672px, (min-width: 640px) 544px, calc(100vw - 96px)"
  format="webp"
  loading="lazy"
  decoding="async"
  class:list={["rounded-t-xl xl:rounded-xl", className]}
/>
