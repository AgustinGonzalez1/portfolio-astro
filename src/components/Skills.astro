---
import { skillGroups } from "../data/skills";
import { profile } from "../data/profile";
import type { SkillGroup } from "../types/skills";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="skills"
  class="skills-section"
  kicker="Herramientas"
  title="Tecnologías que utilizo."
  description={profile.skillsDescription}
>
  {
    skillGroups.map(({ title, items }: SkillGroup) => (
      <div class="skill-row">
        <h3>{title}</h3>
        <p>
          {items.map((skill: string, index: number) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">·</span>}
              {skill}
            </Fragment>
          ))}
        </p>
      </div>
    ))
  }
</ContentSection>
