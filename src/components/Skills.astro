---
import { skillGroups } from "../data/skills";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="skills"
  class="skills-section"
  kicker="Herramientas"
  title="Tecnologías que utilizo."
  description="Sigo aprendiendo y ampliando mis herramientas para resolver distintos problemas."
>
  {
    skillGroups.map(({ title, items }) => (
      <div class="skill-row">
        <h3>{title}</h3>
        <p>
          {items.map((skill, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">·</span>}
              {skill}
            </Fragment>
          ))}
        </p>
      </div>
    ))
  }
</ContentSection>
