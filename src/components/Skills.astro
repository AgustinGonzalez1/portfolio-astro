---
import { skillGroups } from "../data/skills";
import { profile } from "../data/profile";
import type { SkillGroup } from "../types/skills";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="skills"
  class="skills-section"
  kicker="Herramientas"
  title="Tecnologías que utilizo."
  description={profile.skillsDescription}
>
  {
    skillGroups.map(({ title, items }: SkillGroup) => (
      <div class="skill-row">
        <h3>{title}</h3>
        <p>
          {items.map((skill: string, index: number) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">·</span>}
              {skill}
            </Fragment>
          ))}
        </p>
      </div>
    ))
  }
</ContentSection>

<style>
  :global(.content-section.skills-section) {
    padding: 104px 0 126px;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 42px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .skill-row h3 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
  }

  .skill-row p {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 13px;
    align-items: center;
    color: #a2a8ae;
    font-size: 13px;
    line-height: 1.8;
  }

  .skill-row p span {
    color: #434a50;
  }

  @media (max-width: 720px) {
    :global(.content-section.skills-section) {
      padding: 80px 0 96px;
    }

    .skill-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 24px 0;
    }

    .skill-row h3 {
      font-size: 26px;
    }

    .skill-row p {
      font-size: 12px;
    }
  }
</style>
