---
import { skills } from "../data/skills";
import { profile } from "../data/profile";
---

<section class="flex flex-col md:flex-row justify-between gap-4">
  <section>
    <h2 class="text-4xl xl:text-7xl font-bebas text-white">Mis habilidades</h2>
  </section>
  <section class="flex flex-col gap-8 w-full md:max-w-[50%]">
    <p class="text-subtext font-manrope xl:text-lg">
      {profile.skillsDescription}
      <br />
      Las tecnologías que utilizo son:
    </p>
    <div class="flex flex-wrap gap-4">
      {
        skills.map((skill: string) => (
          <div class="flex items-center w-fit px-6 py-3 border-[2px] border-[#484848] rounded-md">
            <p class="text-subtext font-manrope text-sm font-bold">{skill}</p>
          </div>
        ))
      }
    </div>
  </section>
</section>
