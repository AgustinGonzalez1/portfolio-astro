---
import { socialLinks, type SocialNetwork } from "../data/socials";

interface Props {
  networks?: SocialNetwork[];
  variant?: "circle" | "plain";
  class?: string;
}

const {
  networks = ["linkedin", "github"],
  variant = "circle",
  class: className,
} = Astro.props;
---

<div class:list={["flex", variant === "circle" ? "gap-4" : "gap-2", className]}>
  {
    networks.map((network: SocialNetwork) => {
      const { href, label, icon } = socialLinks[network];
      const isExternal = href.startsWith("https://");

      return (
        <a
          href={href}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class:list={{
            "w-12 h-12 flex items-center justify-center bg-[#222222] rounded-full hover:bg-transparent border-2 border-[#222222] hover:border-primary duration-300 ease-in-out":
              variant === "circle",
          }}
        >
          <img
            src={icon}
            alt={label}
            class:list={{ "w-8": variant === "plain" }}
          />
        </a>
      );
    })
  }
</div>
