---
import SocialLinks from "./SocialLinks.astro";
const currentYear = new Date().getFullYear();
---

<section
  id="contact"
  class="flex flex-col justify-start md:justify-center gap-10 items-center"
>
  <div class="flex flex-col gap-10">
    <h2 class="text-4xl xl:text-7xl font-bebas text-white text-center">
      ¡Contáctame!
    </h2>
    <SocialLinks
      networks={["linkedin", "github", "instagram", "email"]}
      variant="plain"
      class="justify-center"
    />
  </div>
  <footer>
    <p class="text-center text-subtext font-manrope text-sm">
      © {currentYear} Ricardo Gonzalez
    </p>
  </footer>
</section>
