---
import SocialLinks from "./SocialLinks.astro";
import { profile } from "../data/profile";
import { socialLinks } from "../data/socials";

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="site-footer" aria-labelledby="contact-heading">
  <div class="footer-top">
    <div>
      <p class="section-kicker">Contacto</p>
      <h2 class="footer-title" id="contact-heading">
        {profile.contact.title}<span class="accent">.</span>
      </h2>
    </div>
    <div>
      <p class="footer-copy">{profile.contact.description}</p>
      <a class="footer-cta" href={socialLinks.email.href}>
        <span>Escribime <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-meta">
      <span><strong>{profile.name}</strong> · Vulcanis</span>
      <span><strong>Base</strong> {profile.location}</span>
      <span><strong>© {currentYear}</strong> Todos los derechos reservados</span
      >
    </div>
    <div class="footer-socials">
      <SocialLinks
        networks={["linkedin", "github", "instagram", "youtube", "email"]}
        variant="outline"
      />
    </div>
  </div>
</footer>
