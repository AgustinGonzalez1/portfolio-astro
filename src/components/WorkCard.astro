---
import ProjectImage from "./ProjectImage.astro";
import type { WorkDetail, WorkItem } from "../types/work";

interface Props extends WorkItem {
  details?: WorkDetail[];
}

const { title, description, img, link, details = [] }: Props = Astro.props;
const hasDetails = details.length > 0;
---

<article class="flex flex-col gap-10 xl:grid xl:grid-cols-2">
  <div
    class="bg-[#1A1A1A] hover:bg-[#333333] hover:translate-y-[-20px] duration-300 flex items-center justify-center rounded-t-xl px-8 pt-8 xl:p-8 xl:rounded-xl"
  >
    <ProjectImage
      src={img}
      alt={title}
      class:list={{ "w-full": !hasDetails }}
    />
  </div>
  <div
    class:list={[
      "flex flex-col gap-10",
      hasDetails ? "justify-center" : "justify-between",
    ]}
  >
    <div>
      <h3 class="text-3xl text-white font-manrope font-medium">
        {title}
      </h3>
      <p class="text-subtext font-manrope xl:text-lg">{description}</p>
    </div>
    {
      hasDetails && (
        <div class="flex flex-col gap-4">
          <h4 class="text-white font-manrope font-semibold">INFORMACIÓN</h4>
          <dl class="flex flex-col gap-4 text-subtext font-manrope font-medium">
            {details.map(({ label, value }: WorkDetail) => (
              <div class="flex justify-between border-t border-[#484848] pt-4">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
    <a
      href={link}
      aria-label={`Visitar ${title}`}
      class="flex gap-1 border-b-2 w-fit border-primary hover:border-subtext duration-300 ease-in-out text-subtext font-manrope"
      rel="noopener noreferrer"
      target="_blank"
    >
      VISITAR
      <img src="/arrow.svg" alt="" aria-hidden="true" />
    </a>
  </div>
</article>
