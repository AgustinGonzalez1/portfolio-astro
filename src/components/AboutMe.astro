---
import ContactHeader from "./ContactHeader.astro";
import { profile } from "../data/profile";
---

<section
  id="about"
  class="about-intro"
  aria-labelledby="about-page-title"
  transition:name="about"
>
  <p class="section-kicker">Perfil / {profile.name}</p>
  <div class="about-grid">
    <div>
      <h1 id="about-page-title">Sobre mí<span>.</span></h1>
      <p class="about-lead">{profile.about.headline}</p>
      <ContactHeader />
    </div>
    <div class="about-copy">
      {profile.about.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
