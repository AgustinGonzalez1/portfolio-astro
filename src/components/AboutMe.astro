---
import ContactHeader from "./ContactHeader.astro";
import { profile } from "../data/profile";
---

<section
  id="about"
  class="about-intro"
  aria-labelledby="about-page-title"
  transition:name="about"
>
  <p class="section-kicker">Perfil / {profile.name}</p>
  <div class="about-grid">
    <div>
      <h1 id="about-page-title">Sobre mí<span>.</span></h1>
      <p class="about-lead">{profile.about.headline}</p>
      <ContactHeader />
    </div>
    <div class="about-copy">
      {profile.about.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about-intro {
    width: min(var(--container-site), calc(100% - 80px));
    margin-inline: auto;
    padding: 104px 0 112px;
    color: var(--color-foreground);
    font-family: var(--font-dm-sans);
    font-weight: 400;
    line-height: normal;
    -webkit-font-smoothing: antialiased;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.68fr);
    gap: 100px;
    margin-top: 31px;
    align-items: start;
  }

  h1 {
    max-width: 780px;
    font-family: var(--font-display);
    font-size: clamp(70px, 7vw, 112px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  h1 span {
    color: var(--color-accent);
  }

  .about-lead {
    margin-top: 35px;
    max-width: 740px;
    font-family: var(--font-display);
    font-size: clamp(29px, 2.8vw, 43px);
    line-height: 1.25;
    letter-spacing: -0.018em;
  }

  .about-copy {
    padding-top: 12px;
    max-width: 490px;
  }

  .about-copy p {
    color: #90979d;
    font-size: 15px;
    line-height: 1.95;
  }

  .about-copy p + p {
    margin-top: 22px;
  }

  @media (max-width: 1150px) {
    .about-grid {
      gap: 60px;
    }
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .about-copy {
      padding-top: 0;
      max-width: 680px;
    }
  }

  @media (max-width: 720px) {
    .about-intro {
      width: calc(100% - 34px);
      padding: 76px 0 88px;
    }

    h1 {
      font-size: 72px;
    }

    .about-lead {
      font-size: 32px;
      margin-top: 24px;
    }

    .about-copy p {
      font-size: 14px;
    }
  }
</style>
