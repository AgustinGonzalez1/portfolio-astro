---
const { pathname } = Astro.url;
import ContactHeader from "./ContactHeader.astro";
import { profile } from "../data/profile";
---

<aside id="about" class="flex flex-col md:flex-row justify-between gap-4 pt-10">
  <div>
    <h2 class="text-4xl xl:text-7xl font-bebas text-white">Sobre mí</h2>
  </div>
  <div class="flex flex-col md:max-w-[50%] gap-8">
    <div class="flex flex-col gap-4">
      <h4 class="text-white text-2xl font-manrope">
        {profile.about.headline}
      </h4>
      <p class="text-subtext font-manrope xl:text-lg">
        {profile.about.background} Actualmente soy {profile.about.teaching.role} en
        <span class="text-primary">{profile.about.teaching.organization}</span>
        y {profile.about.development.role} en
        <span class="text-primary"
          >{profile.about.development.organization}</span
        >.
      </p>
    </div>
    {
      pathname === "/" ? (
        <div>
          <a
            href="/about"
            class="text-primary font-manrope text-primary-hover w-fit block"
          >
            Más sobre mí
          </a>
        </div>
      ) : (
        <ContactHeader />
      )
    }
  </div>
</aside>
