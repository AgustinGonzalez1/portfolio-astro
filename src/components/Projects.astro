---
import { projects } from "../data/projects";
import type { Project } from "../types/projects";
import WorkCard from "./WorkCard.astro";
import WorkSection from "./WorkSection.astro";
---

<WorkSection
  id="projects"
  title="Proyectos destacados"
  description="Estos son algunos de los proyectos que he creado a lo largo de mi carrera."
>
  {
    projects.map((project: Project) => (
      <WorkCard
        {...project}
        details={[
          { label: "Año", value: project.year },
          { label: "Rol", value: project.role },
        ]}
      />
    ))
  }
</WorkSection>
