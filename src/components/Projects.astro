---
import { projects } from "../data/projects";
import WorkRow from "./WorkRow.astro";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="projects"
  kicker="Proyectos seleccionados"
  title="Trabajo pensado para funcionar y sentirse bien."
  description="Algunos proyectos que resumen mi forma de trabajar: interfaces claras, estructura sólida y decisiones visuales con intención."
>
  {
    projects.map((project, index) => (
      <WorkRow
        {...project}
        index={index + 1}
        details={[
          { label: "Año", value: project.year },
          { label: "Stack", value: project.stack },
        ]}
      />
    ))
  }
</ContentSection>
