---
import { profile } from "../data/profile";

const isHome = Astro.url.pathname === "/";
---

<header class="site-header" data-navigation>
  <div class:list={["header-inner", { "header-inner-sub": !isHome }]}>
    <a
      class="logo"
      href={isHome ? "#home" : "/"}
      aria-label={isHome ? "Vulcanis, inicio" : "Volver al inicio de Vulcanis"}
    >
      <img src={profile.logo} alt="" width="31" height="31" />
    </a>

    {
      isHome ? (
        <>
          <button
            type="button"
            class="menu-toggle"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="navigation-links"
          >
            <span aria-hidden="true" />
          </button>
          <nav
            id="navigation-links"
            class="navigation-links"
            aria-label="Navegación principal"
          >
            <div class="navigation-panel">
              <ul class="navigation-list">
                <li>
                  <a href="#home">Inicio</a>
                </li>
                <li>
                  <a href="#about">Sobre mí</a>
                </li>
                <li>
                  <a href="#projects">Proyectos</a>
                </li>
                <li>
                  <a href="#contributions">Aportes</a>
                </li>
                <li>
                  <a href="#experience">Experiencia</a>
                </li>
              </ul>
            </div>
          </nav>
          <a class="contact-top" href="#contact">
            Contacto <span aria-hidden="true">↗</span>
          </a>
        </>
      ) : (
        <a class="contact-top" href="/">
          Volver al inicio <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.querySelector<HTMLElement>("[data-navigation]");
    const toggle = navigation?.querySelector<HTMLButtonElement>(".menu-toggle");
    const links = navigation?.querySelector<HTMLElement>("#navigation-links");

    if (!navigation || !toggle || !links) return;

    const controller = new AbortController();
    const { signal } = controller;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    toggle.addEventListener(
      "click",
      () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      },
      { signal },
    );

    navigation.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof Node &&
          !navigation.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  });
</script>
