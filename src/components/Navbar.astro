---
import { profile } from "../data/profile";

const isHome = Astro.url.pathname === "/";
---

<header class="site-header" data-navigation>
  <div class:list={["header-inner", { "header-inner-sub": !isHome }]}>
    <a
      class="logo"
      href={isHome ? "#home" : "/"}
      aria-label={isHome ? "Vulcanis, inicio" : "Volver al inicio de Vulcanis"}
    >
      <img src={profile.logo} alt="" width="31" height="31" />
    </a>

    {
      isHome ? (
        <>
          <button
            type="button"
            class="menu-toggle"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="navigation-links"
          >
            <span aria-hidden="true" />
          </button>
          <nav
            id="navigation-links"
            class="navigation-links"
            aria-label="Navegación principal"
          >
            <div class="navigation-panel">
              <ul class="navigation-list">
                <li>
                  <a href="#home">Inicio</a>
                </li>
                <li>
                  <a href="#about">Sobre mí</a>
                </li>
                <li>
                  <a href="#projects">Proyectos</a>
                </li>
                <li>
                  <a href="#contributions">Aportes</a>
                </li>
                <li>
                  <a href="#experience">Experiencia</a>
                </li>
              </ul>
            </div>
          </nav>
          <a class="contact-top" href="#contact">
            Contacto <span aria-hidden="true">↗</span>
          </a>
        </>
      ) : (
        <a class="contact-top" href="/">
          Volver al inicio <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    min-height: 84px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-family: var(--font-dm-sans);
    font-weight: 400;
    line-height: normal;
    -webkit-font-smoothing: antialiased;
  }

  .header-inner {
    width: min(var(--container-site), calc(100% - 80px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 110px;
    align-items: center;
  }

  .header-inner-sub {
    grid-template-columns: 1fr auto;
  }

  .logo,
  .logo img {
    display: block;
    width: 31px;
    height: 31px;
  }

  .logo img {
    object-fit: contain;
  }

  .navigation-list {
    display: flex;
    justify-content: center;
    gap: clamp(15px, 2.2vw, 34px);
    color: #9ca1a6;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .navigation-list a {
    transition: color 0.2s ease;
  }

  .navigation-list a:hover {
    color: var(--color-foreground);
  }

  .contact-top {
    justify-self: end;
    color: var(--color-accent);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .header-inner {
      min-height: 83px;
      grid-template-columns: 1fr auto;
      gap: 0 20px;
    }

    .navigation-links {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-bottom: 20px;
    }

    .navigation-list {
      justify-content: flex-start;
      gap: 26px;
    }

    .contact-top {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 720px) {
    .header-inner {
      width: calc(100% - 34px);
      grid-template-columns: 1fr auto 44px;
      gap: 16px;
    }

    .header-inner-sub {
      grid-template-columns: 1fr auto;
    }

    .navigation-links {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      display: grid;
      grid-template-rows: 0fr;
      padding: 0;
      visibility: hidden;
      background: var(--color-background);
      transition:
        grid-template-rows 0.3s ease-out,
        visibility 0s linear 0.3s;
    }

    .navigation-panel {
      min-height: 0;
      overflow: hidden;
    }

    .navigation-list {
      flex-direction: column;
      gap: 0;
      padding: 12px 17px 24px;
      border-bottom: 1px solid var(--color-border);
    }

    .navigation-list a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .menu-toggle {
      position: relative;
      display: block;
      grid-column: 3;
      grid-row: 1;
      width: 44px;
      height: 44px;
      cursor: pointer;
      color: var(--color-foreground);
    }

    .menu-toggle[aria-expanded="true"] + .navigation-links {
      grid-template-rows: 1fr;
      visibility: visible;
      transition-delay: 0s;
    }

    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      position: absolute;
      width: 24px;
      height: 1px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        background-color 0.2s ease;
    }

    .menu-toggle span {
      top: calc(50% - 0.5px);
      left: 10px;
    }

    .menu-toggle span::before,
    .menu-toggle span::after {
      content: "";
      left: 0;
    }

    .menu-toggle span::before {
      transform: translateY(-7px);
    }

    .menu-toggle span::after {
      transform: translateY(7px);
    }

    .menu-toggle[aria-expanded="true"] span {
      background: transparent;
    }

    .menu-toggle[aria-expanded="true"] span::before {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] span::after {
      transform: rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-links,
    .navigation-list a,
    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.querySelector<HTMLElement>("[data-navigation]");
    const toggle = navigation?.querySelector<HTMLButtonElement>(".menu-toggle");
    const links = navigation?.querySelector<HTMLElement>("#navigation-links");

    if (!navigation || !toggle || !links) return;

    const controller = new AbortController();
    const { signal } = controller;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    toggle.addEventListener(
      "click",
      () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      },
      { signal },
    );

    navigation.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof Node &&
          !navigation.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  });
</script>
