---
import { profile } from "../data/profile";
const { pathname } = Astro.url;
---

<nav
  aria-label="Navegación principal"
  data-navigation
  class="py-7 px-4 fixed container mx-auto w-full bg-[#0a0a0a] z-50"
>
  <div class="flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img
        src={profile.logo}
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0 object-contain"
      />
    </a>

    {
      pathname === "/" ? (
        <>
          <button
            type="button"
            class="menu-toggle sm:hidden"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="navigation-links"
          >
            <span aria-hidden="true" />
          </button>
          <ul
            id="navigation-links"
            class="navigation-links text-sm bg-[#0a0a0a] gap-8 flex flex-col items-center justify-center sm:flex-row w-full sm:w-fit text-subtext font-manrope absolute top-full overflow-hidden left-0 sm:static"
          >
            <li>
              <a href="#contributions">Aportes</a>
            </li>
            <li>
              <a href="#projects">Proyectos</a>
            </li>
            <li>
              <a href="#about">Sobre mí</a>
            </li>
            <li>
              <a href="#contact">Contacto</a>
            </li>
          </ul>
        </>
      ) : (
        <a
          href="/"
          class="text-xl xl:text-3xl text-subtext font-bebas hover:text-primary duration-300 ease-in-out"
        >
          Volver
        </a>
      )
    }
  </div>
</nav>

<style>
  .navigation-links {
    height: 0;
    visibility: hidden;
    transition:
      height 0.3s ease-out,
      visibility 0s linear 0.3s;
  }

  .navigation-links a:hover {
    color: white;
  }

  .menu-toggle[aria-expanded="true"] + .navigation-links {
    height: 200px;
    visibility: visible;
    transition-delay: 0s;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    position: relative;
    cursor: pointer;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    position: absolute;
    width: 30px;
    height: 3px;
    background-color: white;
    border-radius: 5px;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .menu-toggle span {
    top: calc(50% - 1.5px);
    left: 7px;
  }

  .menu-toggle span::before,
  .menu-toggle span::after {
    content: "";
    left: 0;
  }

  .menu-toggle span::before {
    transform: translateY(-10px);
  }

  .menu-toggle span::after {
    transform: translateY(10px);
  }

  .menu-toggle[aria-expanded="true"] span {
    background-color: transparent;
  }

  .menu-toggle[aria-expanded="true"] span::before {
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span::after {
    transform: rotate(-45deg);
  }

  @media (min-width: 40rem) {
    .navigation-links,
    .menu-toggle[aria-expanded="true"] + .navigation-links {
      height: auto;
      visibility: visible;
      overflow: visible;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-links,
    .menu-toggle span,
    .menu-toggle span::before,
    .menu-toggle span::after {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.querySelector<HTMLElement>("[data-navigation]");
    const toggle = navigation?.querySelector<HTMLButtonElement>(".menu-toggle");
    const links =
      navigation?.querySelector<HTMLUListElement>("#navigation-links");

    if (!navigation || !toggle || !links) return;

    const controller = new AbortController();
    const { signal } = controller;

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()), { signal });

    links.addEventListener(
      "click",
      (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof Node &&
          !navigation.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  });
</script>
