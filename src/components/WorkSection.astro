---
interface Props {
  id: string;
  title: string;
  description: string;
}

const { id, title, description } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  class="flex flex-col gap-16 md:gap-20"
  id={id}
  aria-labelledby={headingId}
>
  <header>
    <h2 id={headingId} class="text-4xl xl:text-7xl font-bebas text-white">
      {title}
    </h2>
    <p class="text-subtext font-manrope">{description}</p>
  </header>
  <div class="flex flex-col gap-28">
    <slot />
  </div>
</section>
