---
import { Image } from "astro:assets";
import { experiences } from "../data/experience";
import type { Experience } from "../types/experience";
---

<section
  id="experience"
  class="flex flex-col lg:flex-row justify-between gap-4 pt-10"
>
  <div>
    <h2 class="text-4xl xl:text-7xl font-bebas text-white">Experiencia</h2>
  </div>
  <div class="flex flex-col md:min-w-[50%] gap-8">
    <!-- card -->

    {
      experiences.map((experience: Experience) => (
        <div class="flex items-center justify-between gap-4 w-full">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 w-full">
            <div class="flex gap-4 text-white">
              <Image
                src={experience.logo}
                alt={experience.title}
                width={52}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
                decoding="async"
                class="w-13 h-13 object-contain shrink-0"
              />
              <div class="flex flex-col text-white">
                <h3 class="text-xl font-manrope">{experience.title}</h3>
                <p>{experience.role}</p>
              </div>
            </div>
            <div class="flex justify-end">
              <p class="text-subtext font-manrope xl:text-lg">
                {experience.date}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <!-- card -->
</section>
