---
import { experiences } from "../data/experience";
import type { Experience } from "../types/experience";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="experience"
  kicker="Experiencia"
  title="Producto, desarrollo y docencia en contextos reales."
  description="Una trayectoria que combina trabajo en equipos de producto, desarrollo full stack y enseñanza de programación."
>
  <div class="timeline">
    {
      experiences.map((experience: Experience) => (
        <article class:list={["exp-row", { current: !experience.endDate }]}>
          <p class="exp-date">
            {experience.startDate}
            <br />
            {experience.endDate ?? "Actualidad"}
          </p>
          <span class="exp-dot" aria-hidden="true" />
          <div class="exp-main">
            <h3 class="exp-company">{experience.title}</h3>
            <p class="exp-role">{experience.role}</p>
          </div>
          <dl class="exp-side">
            <dt class="exp-label">Enfoque</dt>
            <dd class="exp-value">{experience.focus}</dd>
          </dl>
        </article>
      ))
    }
  </div>
</ContentSection>

<style>
  .timeline {
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 145px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #171b1f;
  }

  .exp-row {
    position: relative;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 220px;
    gap: 46px;
    align-items: start;
    min-height: 150px;
    padding: 32px 0 34px;
    border-bottom: 1px solid var(--color-border);
  }

  .exp-date {
    padding-top: 7px;
    color: #626970;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1.7;
  }

  .exp-dot {
    position: absolute;
    left: 141px;
    top: 45px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-background);
    border: 1px solid #3a4046;
    z-index: 1;
  }

  .exp-row.current .exp-dot {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .exp-main {
    min-width: 0;
  }

  .exp-company {
    margin-bottom: 9px;
    font-family: var(--font-display);
    font-size: clamp(34px, 3.4vw, 52px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.026em;
  }

  .exp-role {
    color: #969ca2;
    font-size: 13px;
    line-height: 1.6;
  }

  .exp-side {
    min-width: 0;
    padding-top: 8px;
    text-align: right;
  }

  .exp-label {
    display: block;
    margin-bottom: 7px;
    color: #626970;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .exp-value {
    display: inline;
    color: #adb2b7;
    font-size: 11px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .timeline::before {
      left: 105px;
    }

    .exp-row {
      grid-template-columns: 82px minmax(0, 1fr);
      gap: 36px;
    }

    .exp-dot {
      left: 101px;
    }

    .exp-side {
      grid-column: 2;
      text-align: left;
      padding-top: 0;
      margin-top: -8px;
    }
  }

  @media (max-width: 720px) {
    .timeline::before {
      left: 72px;
    }

    .exp-row {
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 30px;
      min-height: 0;
      padding: 26px 0 28px;
    }

    .exp-dot {
      left: 68px;
      top: 38px;
    }

    .exp-date {
      font-size: 9px;
    }

    .exp-company {
      font-size: 32px;
    }
  }
</style>
