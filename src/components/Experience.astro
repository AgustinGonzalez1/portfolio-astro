---
import { experiences } from "../data/experience";
import ContentSection from "./ContentSection.astro";
---

<ContentSection
  id="experience"
  kicker="Experiencia"
  title="Producto, desarrollo y docencia en contextos reales."
  description="Una trayectoria que combina trabajo en equipos de producto, desarrollo full stack y enseñanza de programación."
>
  <div class="timeline">
    {
      experiences.map((experience) => (
        <article class:list={["exp-row", { current: !experience.endDate }]}>
          <p class="exp-date">
            {experience.startDate}
            <br />
            {experience.endDate ?? "Actualidad"}
          </p>
          <span class="exp-dot" aria-hidden="true" />
          <div class="exp-main">
            <h3 class="exp-company">{experience.title}</h3>
            <p class="exp-role">{experience.role}</p>
          </div>
          <dl class="exp-side">
            <dt class="exp-label">Enfoque</dt>
            <dd class="exp-value">{experience.focus}</dd>
          </dl>
        </article>
      ))
    }
  </div>
</ContentSection>
